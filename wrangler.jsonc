{
  "name": "butterflydynamix",
  "compatibility_date": "2026-07-08",
  "observability": {
    "enabled": true
  },
  "main": "src/index.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "compatibility_flags": ["nodejs_compat"]
}
